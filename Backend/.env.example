# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/resume_checker?retryWrites=true&w=majority

# JWT secret key for signing auth tokens
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API key
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Server Port (Render sets this automatically)
PORT=3000

# Frontend URL for CORS (e.g. your Vercel deployment URL)
FRONTEND_URL=https://interview-ai-cyan-tau.vercel.app

# Node Environment
NODE_ENV=production
